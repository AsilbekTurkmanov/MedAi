# MEDAI Platform Environment Variables

# PostgreSQL Database Configuration
POSTGRES_DB=medaidb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=medaidb;Username=postgres;Password=your_secure_postgres_password_here

# JWT Security
JWT_SECRET=MedAI_Super_Secret_JWT_Key_2026_For_Healthcare_Platform_Security!
JWT_ISSUER=MedAI
JWT_AUDIENCE=MedAIClient

# AI Provider Integration
AI_PROVIDER=OpenAI
AI_API_KEY=your_openai_or_gemini_api_key_here

# Frontend
NEXT_PUBLIC_API_URL=https://localhost:7001/api
