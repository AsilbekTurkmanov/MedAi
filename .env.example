# MEDAI Platform Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# PostgreSQL Database Configuration
# ============================================
POSTGRES_DB=medaidb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5434
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5434;Database=medaidb;Username=postgres;Password=your_secure_postgres_password_here

# ============================================
# JWT Security (REQUIRED in production)
# ============================================
# Must be at least 64 characters long
JWT_SECRET=your_jwt_secret_key_here_must_be_at_least_64_characters_long_change_this
JWT_ISSUER=MedAI
JWT_AUDIENCE=MedAIClient

# ============================================
# AI Provider Integration
# ============================================
# Supported providers: OpenAI, Gemini
AI_PROVIDER=OpenAI
AI_API_KEY=your_openai_or_gemini_api_key_here
AI_MODEL=gpt-4o

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins (production only)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ============================================
# Frontend
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:5050/api

# ============================================
# Redis (optional — for caching/rate limiting)
# ============================================
REDIS_PORT=6380

# ============================================
# File Storage
# ============================================
# Local storage path for uploaded documents
FILE_STORAGE_PATH=./uploads

# ============================================
# Docker Ports
# ============================================
BACKEND_PORT=5050
FRONTEND_PORT=3010
